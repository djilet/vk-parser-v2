# Корень PHP API (вместе с префиксом /api)
API_BASE_URL=https://football.dev.roowix.com/api

# Телефон пользователя с ROLE_ADMIN — он же username в /login_check
API_PHONE=+79991115577

# Одноразовый код: на dev/sandbox/test бэкенд всегда ставит 1234
API_CODE=1234

# Где хранится bearer-токен между запусками (по умолчанию .auth-token.json)
# API_TOKEN_FILE=.auth-token.json

SLACK_WEBHOOK_URL=https://hooks.slack.com/services/XXX/YYY/ZZZ
STATS_TIMEZONE=Europe/Moscow

# Старая база Supabase — нужна только для npm run migrate-supabase
# SB_URL=https://xxx.supabase.co
# SB_KEY=

# Yandex Cloud — для npm run check-fraud (те же значения, что YANDEX_GPT_API_KEY /
# YANDEX_GPT_FOLDER_ID / YANDEX_GPT_MODEL в imgame-backend)
# YANDEX_GPT_API_KEY=
# YANDEX_GPT_FOLDER_ID=
YANDEX_GPT_MODEL=yandexgpt-lite/latest

# VK API — для npm run vk-token / sync-messages*
# Номер аккаунта VK (1 или 2): свой токен и профиль Chrome на каждый
# VK_BROWSER=1
# Таймаут одного запроса к api.vk.com, мс
# VK_REQUEST_TIMEOUT_MS=30000
# Пауза между запросами к VK API, мс (user-токен ограничен 3 запросами в секунду)
# VK_REQUEST_DELAY_MS=350
