# Корень PHP API (вместе с префиксом /api)
API_BASE_URL=https://football.dev.roowix.com/api

# Телефон пользователя с ROLE_ADMIN — он же username в /login_check
API_PHONE=+79991115577

# Одноразовый код: на dev/sandbox/test бэкенд всегда ставит 1234
API_CODE=1234

# Где хранится bearer-токен между запусками (по умолчанию .auth-token.json, относительно корня репо)
# API_TOKEN_FILE=.auth-token.json
# Таймаут одного запроса к API, мс
# API_REQUEST_TIMEOUT_MS=30000

SLACK_WEBHOOK_URL=https://hooks.slack.com/services/XXX/YYY/ZZZ
STATS_TIMEZONE=Europe/Moscow

# Yandex Cloud — для npm run check-fraud
# YANDEX_GPT_API_KEY=
# YANDEX_GPT_FOLDER_ID=
YANDEX_GPT_MODEL=yandexgpt-lite/latest

# VK — для vk-sales-bot vk *, parse, send, sync-messages
# Страница входа VK
# VK_LOGIN_URL=https://vk.com/login
# false — видимый браузер (по умолчанию), true — headless
# HEADLESS=false
# Подключиться к уже запущенному Chrome вместо запуска своего: http://127.0.0.1:9222
# CONNECT_URL=
# Таймаут одного запроса к api.vk.com, мс
# VK_REQUEST_TIMEOUT_MS=30000
# Пауза между запросами к VK API, мс (user-токен ограничен 3 запросами в секунду)
# VK_REQUEST_DELAY_MS=350

# HTTP-сервер чата (apps/server)
# PORT=3001
# CORS_ORIGIN=http://localhost:5173

# Тайминги отправки сообщения в VK-композер — намеренная антидетект-пауза, не для оптимизации
# SEND_CHAT_LOAD_WAIT_MS=5000
# SEND_BEFORE_WRITE_MS=180000
# SEND_BEFORE_SEND_MS=10000
