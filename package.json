{
  "name": "vk-chat-bot",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "bin": {
    "vk-token": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsc",
    "dev:server": "tsx server/index.ts",
    "dev:web": "npm run dev --prefix web",
    "dev": "npm run dev:server & sleep 1 && npm run dev:web",
    "vk:session": "tsx src/cli.ts session",
    "vk:token": "tsx src/cli.ts token",
    "vk:token-all": "tsx src/cli.ts token-all",
    "vk:tokens": "tsx src/cli.ts list",
    "vk:show": "tsx src/cli.ts show",
    "vk:get": "tsx src/cli.ts get",
    "vk:unread": "tsx src/cli.ts unread",
    "vk:send": "tsx src/cli.ts send"
  },
  "dependencies": {
    "commander": "^13.1.0",
    "puppeteer": "^24.2.1"
  },
  "devDependencies": {
    "@types/node": "^22.13.4",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3"
  }
}
